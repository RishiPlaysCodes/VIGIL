# ─── Django Core ──────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-key

# Set to 0 in production
DJANGO_DEBUG=1

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to 0 if behind a load balancer that handles SSL
SECURE_SSL_REDIRECT=0

# ─── Database ─────────────────────────────────────────────────────────────────
# For production, use PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/pocket_guardian
# Leave unset for SQLite (development only)

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=alerts@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=alerts@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1

# ─── SMS Provider ────────────────────────────────────────────────────────────
# Options: console (dev), msg91, twilio
SMS_PROVIDER=console

# MSG91 credentials
MSG91_AUTHKEY=replace-me
MSG91_SENDER_ID=replace-me
MSG91_ROUTE=4
MSG91_COUNTRY=91

# Twilio credentials
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=replace-me

# ─── Security ────────────────────────────────────────────────────────────────
# Rate limiting: max login attempts within window (seconds)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300

# API token expiry in seconds (default: 30 days)
API_TOKEN_EXPIRY_SECONDS=2592000
